# Copy this file to .env and fill in your own key (never commit .env).
# A free key: https://aistudio.google.com/apikey  (no card needed; about 20 requests a day on 3.8 Flash)
GEMINI_API_KEY=

# Optional limits (defaults shown). 0 = no limit.
MAX_LESSON_MINUTES=10
MAX_LESSONS_PER_DAY=5
HEAVY_DAILY_LIMIT=200

# Optional: a Postgres database (e.g. Neon) so lessons survive restarts. Empty = SQLite file in backend/data
DATABASE_URL=
